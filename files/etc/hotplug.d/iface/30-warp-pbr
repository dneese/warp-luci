#!/bin/sh
# Restore WARP routing after reboot / interface flap.
# Reads /etc/warp/.mode ("all" | "pbr") and re-applies via warp-api.sh.

[ "$INTERFACE" = "warp" ] || exit 0
[ "$ACTION" = "ifup" ]    || exit 0
[ -f /etc/warp/.mode ]    || exit 0

# Захист від рекурсії: warp-api.sh сам робить ifup warp, і hotplug-скрипт
# не повинен перезаписувати режим під час перемикання.
# Busybox на роутері не має stat — час lock'а беремо з його вмісту.
if [ -f /etc/warp/.lock ]; then
  MT=$(cat /etc/warp/.lock 2>/dev/null | tr -cd '0-9')
  NOW=$(date +%s)
  if [ -n "$MT" ] && [ "$MT" -gt 0 ] 2>/dev/null && [ $((NOW - MT)) -lt 120 ]; then
    exit 0
  fi
  # порожній/битий lock — вважаємо мертвим лише якщо пройшло >= 120с
  if [ -z "$MT" ]; then
    exit 0
  fi
  rm -f /etc/warp/.lock
fi

MODE=$(cat /etc/warp/.mode 2>/dev/null)
[ -n "$MODE" ] || exit 0

logger -t warp "warp ifup: restoring mode=$MODE"

# Wait for firewall/nft to be ready (max 15s)
I=0
while [ $I -lt 15 ]; do
  nft list ruleset >/dev/null 2>&1 && break
  sleep 1
  I=$((I+1))
done
sleep 3

case "$MODE" in
  all) /usr/bin/warp-api.sh mode_all  >/dev/null 2>&1 ;;
  pbr) /usr/bin/warp-api.sh mode_pbr  >/dev/null 2>&1 ;;
  *)   exit 0 ;;
esac

# firewall reload після hotplug стирає nft set/правила PBR.
# Чекаємо доки firewall не зміниться і правила не відновляться.
if [ "$MODE" = "pbr" ]; then
  J=0
  while [ $J -lt 8 ]; do
    nft list chain inet fw4 prerouting 2>/dev/null | grep 'blocked_net' | grep -q 'meta mark set' && {
      # правило на місці — перевіряємо ще раз через 2с, чи firewall не знесе його пізніше
      sleep 2
      nft list chain inet fw4 prerouting 2>/dev/null | grep 'blocked_net' | grep -q 'meta mark set' && break
    }
    J=$((J+1))
    sleep 2
  done
  nft list chain inet fw4 prerouting 2>/dev/null | grep 'blocked_net' | grep -q 'meta mark set' || {
    /usr/bin/warp-api.sh pbr_apply >/dev/null 2>&1
    logger -t warp "warp ifup: nft rules wiped by firewall reload — re-applied"
  }
fi

logger -t warp "warp ifup: restore done"